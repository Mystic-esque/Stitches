{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stitches application adjustment intent",
  "description": "Application contract, not an authoritative drafting result. Adapt to the Gemini SDK's supported schema subset and validate all semantics on the server.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["propose", "clarify", "unsupported"] },
    "patternVersionId": { "type": "string", "minLength": 1 },
    "baseRevisionId": { "type": "string", "minLength": 1 },
    "operationId": { "type": ["string", "null"], "enum": ["shoulder-width", null] },
    "deltaMmPerShoulder": { "type": ["number", "null"] },
    "lockedRegions": { "type": "array", "items": { "type": "string", "enum": ["neckline"] }, "uniqueItems": true },
    "clarificationQuestion": { "type": ["string", "null"] },
    "supportingRuleIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "required": ["status", "patternVersionId", "baseRevisionId", "operationId", "deltaMmPerShoulder", "lockedRegions", "clarificationQuestion", "supportingRuleIds"]
}
