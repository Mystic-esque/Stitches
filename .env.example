# Server-only. Supply through local environment files or hosting secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SANITY_PROJECT_ID=l4eeamth
# Use an authorized Stitches-only dataset; do not point writes at Crossgrade data.
SANITY_DATASET=development
SANITY_API_VERSION=2026-09-28
# fixture (default), sanity-development, or sanity-reviewed (production dataset only).
STITCHES_KNOWLEDGE_MODE=fixture
STITCHES_PATTERN_VERSION_ID=pattern-version.everyday-blouse.0-1-0
# Development-only incomplete agent preview. Off until live KB and $0 model tier are verified.
STITCHES_AGENT_PREVIEW_ENABLED=false
STITCHES_GEMINI_ZERO_COST_CONFIRMED=false
STITCHES_AGENT_PREVIEW_TOKEN=
STITCHES_CONTEXT_SHOULDER_PATH=
SANITY_READ_TOKEN=
# Organization-level Context Viewer credential, separate from project tokens.
SANITY_CONTEXT_ORG_ID=o3i0aqvqq
SANITY_CONTEXT_MCP_NAME=
SANITY_CONTEXT_KB_ID=
SANITY_CONTEXT_TOKEN=
# Optional, only for editorial/import workflows; never expose to the app agent.
SANITY_WRITE_TOKEN=
# Later private-persistence milestone.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Keep any elevated Supabase secret entirely server-side; ordinary user queries
# should use authenticated user context and tested row-level policies.

